# Copy these values into the Dokploy Compose service's Environment tab. Dokploy
# writes them to a deployment-local .env file; do not commit a populated copy.
#
# Generate URL-safe secrets so DATABASE_URL and REDIS_URL stay valid without
# additional percent encoding, for example:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Use a distinct generated value for every *_PASSWORD / *_SECRET_KEY setting.

# Public HTTPS origin. The Dokploy profile routes `/` to the web service and
# `/v1` to the API on this same origin. This must be a real public URL, never a
# Docker service name or localhost. NEXT_PUBLIC_API_BASE_URL is baked into the
# Next.js image at build time, so redeploy after changing it.
APP_BASE_URL=https://flexy.example.com
FRONTEND_ORIGIN=https://flexy.example.com
NEXT_PUBLIC_API_BASE_URL=https://flexy.example.com

# PostgreSQL. Keep the password URL-safe and use the identical value in both
# POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_DB=flexy
POSTGRES_USER=flexy
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_URL_SAFE_SECRET
DATABASE_URL=postgresql+psycopg://flexy:REPLACE_WITH_THE_SAME_URL_SAFE_SECRET@postgres:5432/flexy

# Redis uses a private network and authentication. Keep the password URL-safe
# and use the identical value in both REDIS_PASSWORD and REDIS_URL.
REDIS_PASSWORD=REPLACE_WITH_A_UNIQUE_URL_SAFE_SECRET
REDIS_URL=redis://:REPLACE_WITH_THE_SAME_URL_SAFE_SECRET@redis:6379/0

# Private S3-compatible artifact storage. The default Dokploy Compose setup
# runs MinIO internally; use a different bucket/credentials for each environment.
MINIO_ROOT_USER=flexy-storage
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_URL_SAFE_SECRET
S3_ENDPOINT=http://minio:9000
S3_BUCKET=flexy-artifacts
S3_ACCESS_KEY=flexy-storage
S3_SECRET_KEY=REPLACE_WITH_THE_SAME_MINIO_ROOT_PASSWORD
ARTIFACT_BACKEND=s3

# Optional: Compose explicitly defaults S3_SERVER_SIDE_ENCRYPTION to "none"
# for this bundled private MinIO, which has no KMS configured. Protect its
# volume with host-disk encryption. For managed S3, set this to AES256 or aws:kms.
# Encryption failures never retry without encryption. Do not set AES256 on
# MinIO until you have configured and verified a durable key-management service.

# The Docker/Dokploy profile defaults to no build executor. Docker's default
# seccomp policy blocks the worker's namespace setup, so analysis remains safe
# but builds must be unavailable until an operator has installed and validated a
# narrowly reviewed sandbox policy on this specific host. Setting this to bwrap
# alone is not a valid workaround.
BUILD_EXECUTOR=unavailable

# The production Compose file fixes the queue mode, Bubblewrap path, recipe
# path, storage paths, and AUTO_CREATE_SCHEMA=false. Do not add overrides for
# those values in Dokploy: the migration service owns schema changes and the
# worker must not fall back to an unsandboxed executor.

# Untrusted-input, resource, and retention limits.
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACTION_BYTES=262144000
MAX_FILE_COUNT=10000
JOB_TIMEOUT_SECONDS=300
JOB_RETENTION_HOURS=24
DOWNLOAD_TOKEN_TTL_SECONDS=900
LOG_LIMIT_BYTES=1048576
CLEANUP_INTERVAL_SECONDS=3600

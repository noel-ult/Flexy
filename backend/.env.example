# Development services
DATABASE_URL=sqlite:///./flexy.db
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=flexy-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# HTTP application
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Local development storage. The supported end-to-end build workflow is Docker
# Compose; a direct source-only API defaults to unavailable rather than binding
# a workstation runtime into a build sandbox.
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts
FLEXY_RECIPE_DIR=./fixtures/recipes
BUILD_EXECUTOR=unavailable
BWRAP_PATH=/usr/bin/bwrap

# Untrusted-input limits
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACTION_BYTES=262144000
MAX_FILE_COUNT=10000
JOB_TIMEOUT_SECONDS=300
JOB_RETENTION_HOURS=24
DOWNLOAD_TOKEN_TTL_SECONDS=900
AUTO_CREATE_SCHEMA=true
# Used by the deployment-owned Kubernetes Job controller contract.
FLEXY_BUILDER_IMAGE=
CLEANUP_INTERVAL_SECONDS=3600

# Copy to .env for Docker Compose development. These values are intentionally
# development-only; use a secret manager and unique, rotated values in production.

# Published ports
WEB_PORT=3000
API_PORT=8000
MINIO_CONSOLE_PORT=9001

# PostgreSQL (local Compose only)
POSTGRES_DB=flexy
POSTGRES_USER=flexy
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://flexy:change-this-local-password@postgres:5432/flexy

# Queue and private artifact storage
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=flexy-minio
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_ENDPOINT=http://minio:9000
S3_BUCKET=flexy-artifacts
S3_ACCESS_KEY=flexy-minio
S3_SECRET_KEY=change-this-minio-password
ARTIFACT_BACKEND=s3

# Application origins. The browser talks to the API directly in local development.
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Safe local execution defaults. Never change this to an unsandboxed fallback.
BUILD_EXECUTOR=bwrap
BWRAP_PATH=/usr/bin/bwrap
UPLOAD_DIR=/var/lib/flexy/uploads
ARTIFACT_DIR=/var/lib/flexy/artifacts
WORK_DIR=/var/lib/flexy/work
FLEXY_RECIPE_DIR=/srv/flexy/fixtures/recipes
QUEUE_MODE=dramatiq
ALLOW_DEMO_INLINE_QUEUE=false
# Compose is a local development profile. Production uses the Alembic Job in
# infra/k8s and must keep this false.
AUTO_CREATE_SCHEMA=true

# Untrusted-input and retention limits
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACTION_BYTES=262144000
MAX_FILE_COUNT=10000
JOB_TIMEOUT_SECONDS=300
JOB_RETENTION_HOURS=24
DOWNLOAD_TOKEN_TTL_SECONDS=900
LOG_LIMIT_BYTES=1048576
